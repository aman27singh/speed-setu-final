PORT=5050
NODE_ENV=production

# Production database URI (targets speed_setu_db)
MONGO_URI_PROD=mongodb+srv://<username>:<password>@cluster0.mongodb.net/speed_setu_db?retryWrites=true&w=majority

# Active URI (defaults to speed_setu_db in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/speed_setu_db?retryWrites=true&w=majority

# Development database URI (targets test_db)
MONGO_URI_DEV=mongodb+srv://<username>:<password>@cluster0.mongodb.net/test_db?retryWrites=true&w=majority
