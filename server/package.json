{
  "name": "speed-setu-server",
  "version": "1.0.0",
  "description": "Speed Setu Logistics Backend API Server with MongoDB",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development node --watch --watch-path=.env --watch-path=. index.js",
    "build": "echo \"Server ready (no build step required)\"",
    "clear": "cross-env NODE_ENV=development node clear_db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "mongoose": "^8.4.1"
  }
}
